# Datadog credentials for the OpenTelemetry Collector's `datadog` exporter.
# Read by the otel-collector service in the gateway Compose stack.
#
# DD_API_KEY is REQUIRED when OTEL_COLLECTOR_CONFIG=config-datadog.yaml.
# The collector will not start without it.
#
# Get one at: Datadog -> Organization Settings -> API Keys.
# Set DD_SITE to the site your Datadog org lives on:
#   datadoghq.com (US1) | us3.datadoghq.com | us5.datadoghq.com
#   datadoghq.eu (EU1)  | ddog-gov.com      | ap1.datadoghq.com
DD_API_KEY=
DD_SITE=datadoghq.com
