# Copy to verify.env and fill in. verify.env is gitignored — it holds real
# credentials, and every value below rotates whenever the platform is rebuilt.
# Sources for each value are listed in verify-work/setup/CREDENTIALS.md.
#
# PATHS: the scripts look for the unpacked distributions in ../setup relative to
# themselves. Running them from a repo checkout instead? Point WK_SETUP_DIR at
# the directory holding them (or override GW_DIR / PORTAL_DIR / MED_DIR /
# APIM_LOG / IS_LOG individually).
#WK_SETUP_DIR=/path/to/verify-work/setup

# Gateway management API (printed once by the gateway's scripts/setup.sh)
GW_USER=admin
GW_PASS=

# railco's key-manager client — used to mint the token for ./verify.sh --traffic
# (printed by scripts/onboard-tenant.sh)
RAILCO_ID=
RAILCO_SECRET=

# railco's subscription token for OrderManagementAPI. Required because the API
# carries the subscription-validation policy — without it every call returns 403.
# Shown once by the portal when the subscription is created.
RAILCO_SUBKEY=

# acme's equivalents, for driving two-tenant traffic by hand
ACME_ID=
ACME_SECRET=
